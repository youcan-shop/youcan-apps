{% comment %}
  Renders media element

  Usage:
  {% render 'component.media' %}
{% endcomment %}

<div data-component="media" data-aspect-ratio="{{ block.settings.media_aspect_ratio }}">
  {% case block.settings.media_type %}
    {% when 'image' %}
      {% if block.settings.media_image.src %}
        <img src="{{ block.settings.media_image.src }}" alt="{{ product.name }}" height="100%" width="100%">
      {% else %}
        {% render 'component.fallback', size: 40 %}
      {% endif %}
    {% when 'youtube' %}
      <iframe
        width="100%"
        height="100%"
        src="https://www.youtube.com/embed/{{ block.settings.media_video_id }}"
        title="{{ product.name }}"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      >
      </iframe>
    {% else %}
      {% render 'component.fallback' %}
  {% endcase %}
</div>

<style>
  [data-component='media'] {
    width: 100%;
    height: auto;
    overflow: hidden;
    border-radius: clamp(0px, var(--radius-block), var(--radius-28));

    &[data-aspect-ratio='square'] {
      aspect-ratio: 1 / 1;
    }

    &[data-aspect-ratio='portrait'] {
      aspect-ratio: 3 / 4;
    }

    &[data-aspect-ratio='landscape'] {
      aspect-ratio: 16 / 9;
    }

    & > img,
    & > iframe {
      object-fit: cover;
    }
  }
</style>
