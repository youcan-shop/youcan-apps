{% comment %}
  Renders drawer component CSS style

  Usage:
  {% render 'asset.drawer' %}
{% endcomment %}

{% style %}
  [data-slot='drawer-content'] {
    --drawer-width: 512px;

    display: flex;
    position: fixed;
    z-index: 50;
    flex-direction: column;
    justify-content: space-between;
    width: var(--drawer-width);
    height: 100dvh;
    transition: var(--transition-expressive-slow-spatial);
    border: none;
    color: inherit;
    inset: unset;
    inset-block-start: var(--spacing-0);

    {% if block.settings.drawer_position == 'right' %}
      inset-inline-end: calc(var(--drawer-width) * -1);
    {% else %}
      inset-inline-start: calc(var(--drawer-width) * -1);
    {% endif %}

    {% if block.settings.color_scheme == 'light' %}
      background-color: var(--color-app-container);
    {% else %}
      background-color: var(--color-surface);
    {% endif %}

    /* Header */
    [data-slot='drawer-header'] {
      display: flex;
      position: relative;
      z-index: 99;
      align-items: center;
      justify-content: space-between;
      padding: var(--spacing-16);
      gap: var(--spacing-12);
      inset-block-start: 0;
      background-color: var(--color-app-container);

      /* Heading */
      [data-slot='drawer-heading'] {
        flex: 1;
        display: flex;
        gap: var(--spacing-8);
        flex-direction: column;

        /* Title */
        [data-slot='drawer-title'] {
          font: var(--font-body-lg);
        }

        /* Description */
        [data-slot='drawer-description'] {
          opacity: 0.8;
          font: var(--font-body-md);
        }
      }

      /* Icon */
      [data-slot='drawer-icon'] {
        display: flex;
        align-items: center;
        justify-content: center;
        width: calc(var(--spacing-32) + var(--spacing-8));
        height: calc(var(--spacing-32) + var(--spacing-8));
        border-radius: calc(var(--radius-block) * 0.6);
        background-color: var(--color-primary-container);
        color: var(--color-primary);
      }

      /* Close */
      [popovertarget] {
        position: absolute;
        inset-block-start: var(--spacing-16);
        inset-inline-end: var(--spacing-16);
      }
    }

    /* Body */
    [data-slot='drawer-body'] {
      flex: 2;
      padding-inline: var(--spacing-16);
      background-color: var(--color-app-container);
    }

    /* Body */
    [data-slot='drawer-footer'] {
      position: sticky;
      inset-block-end: 0;
      padding: var(--spacing-16);
      background-color: var(--color-app-container);
    }

    /* Backdrop */
    &::backdrop {
      transition: var(--transition-standard-default-spatial);
    }

    /* State */
    &:popover-open {
      {% if block.settings.drawer_position == 'right' %}
        inset-inline-end: var(--spacing-0);
      {% else %}
        inset-inline-start: var(--spacing-0);
      {% endif %}

      &::backdrop {
        background-color: color-mix(in srgb, black 30%, transparent);
      }

      @starting-style {
        {% if block.settings.drawer_position == 'right' %}
          inset-inline-end: calc(var(--drawer-width) * -1);
        {% else %}
          inset-inline-start: calc(var(--drawer-width) * -1);
        {% endif %}

        &::backdrop {
          background-color: transparent;
        }
      }
    }

    @media (width <= 769px) {
      --drawer-width: 100%;
    }
  }

  body:has([data-slot='drawer-content'][popover]:popover-open) {
    &::before {
      content: "";
      position: fixed;
      z-index: 50;
      inset: 0;
    }
  }
{% endstyle %}
