      "max": 168,
      "step": 1,
      "unit": "h",
      "default": 24,
      "visible_if": {
        "setting_id": "mode",
        "value": "evergreen"
      }
    },
    {
      "type": "paragraph",
      "content": "t:blocks.countdown.settings.content.paragraph_2",
      "visible_if": {
        "setting_id": "mode",
        "value": "evergreen"
      }
    },
    {
      "type": "select",
      "id": "expire_behavior",
      "label": "t:blocks.countdown.settings.content.expire_behavior.label",
      "options": [
        {
          "label": "t:blocks.countdown.settings.content.expire_behavior.options.zeros",
          "value": "zeros"
        },
        {
          "label": "t:blocks.countdown.settings.content.expire_behavior.options.message",
          "value": "message"
        },
        {
          "label": "t:blocks.countdown.settings.content.expire_behavior.options.hide",
          "value": "hide"
        },
        {
          "label": "t:blocks.countdown.settings.content.expire_behavior.options.redirect",
          "value": "redirect"
        }
      ],
      "default": "zeros"
    },
    {
      "type": "text",
      "id": "expire_message",
      "label": "t:blocks.countdown.settings.content.expire_message",
      "default": "This offer has ended",
      "visible_if": {
        "setting_id": "expire_behavior",
        "value": "message"
      }
    },
    {
      "type": "text",
      "id": "expire_redirect_url",
      "label": "t:blocks.countdown.settings.content.expire_redirect_url.label",
      "placeholder": "t:blocks.countdown.settings.content.expire_redirect_url.placeholder",
      "visible_if": {
        "setting_id": "expire_behavior",
        "value": "redirect"
      }
    },
    {
      "type": "header",
      "content": "t:blocks.countdown.settings.labels.label"
    },
    {
      "type": "checkbox",
      "id": "show_days",
      "label": "t:blocks.countdown.settings.labels.show_days",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_labels",
      "label": "t:blocks.countdown.settings.labels.show_labels",
      "default": true
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "t:blocks.countdown.settings.labels.label_days",
      "default": "Days",
      "visible_if": {
        "setting_id": "show_labels",
