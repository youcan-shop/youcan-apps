      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "t:blocks.countdown.settings.style.label_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:blocks.countdown.settings.style.gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "digit_color",
      "label": "t:blocks.countdown.settings.style.digit_color",
