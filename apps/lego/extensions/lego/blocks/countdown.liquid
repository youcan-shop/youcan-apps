      "type": "text",
      "id": "label_minutes",
      "label": "t:blocks.countdown.settings.labels.label_minutes",
      "default": "Min",
      "visible_if": {
        "setting_id": "show_labels",
        "value": true
      }
    },
    {
      "type": "text",
      "id": "label_seconds",
      "label": "t:blocks.countdown.settings.labels.label_seconds",
      "default": "Sec",
      "visible_if": {
        "setting_id": "show_labels",
        "value": true
      }
    },
    {
      "type": "header",
      "content": "t:blocks.countdown.settings.style.label"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.countdown.settings.style.style.label",
      "options": [
        {
          "label": "t:blocks.countdown.settings.style.style.options.inline",
          "value": "inline"
        },
        {
          "label": "t:blocks.countdown.settings.style.style.options.boxes",
          "value": "boxes"
        },
        {
          "label": "t:blocks.countdown.settings.style.style.options.grouped",
          "value": "grouped"
        },
        {
          "label": "t:blocks.countdown.settings.style.style.options.flip",
          "value": "flip"
        }
      ],
