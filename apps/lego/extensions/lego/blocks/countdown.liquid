      "type": "number",
      "id": "unit_corner_radius",
      "label": "t:blocks.countdown.settings.style.unit_corner_radius",
      "default": 8,
      "visible_if": {
        "setting_id": "style",
        "operator": "!=",
        "value": "inline"
      }
    },
    {
      "type": "header",
      "content": "t:blocks.countdown.settings.urgency.label"
