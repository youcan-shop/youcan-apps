<div
  data-lego="spacer"
  aria-hidden="true"
  {% if block.settings.anchor %}
    id="{{ block.settings.anchor }}"
  {% endif %}
></div>

<style>
  #youcan-block--{{ block.id }} [data-lego="spacer"] {
    display: block;
    width: 100%;
    height: {{ block.settings.height | append: 'px' }};
    opacity: {{ block.settings.opacity }};

    {% case block.settings.background %}
      {% when 'single-color' %}
        background-color: {{ block.settings.bg_color.hex }};
      {% when 'gradient' %}
        background-image: linear-gradient({{ block.settings.gradient_angle_degree }}deg, {{ block.settings.gradient_start.hex }}, {{ block.settings.gradient_end.hex }});
    {% endcase %}

    {% if block.settings.customize_by_breakpoint %}
      @media (width >= 1200px) {
        height: {{ block.settings.height_lg | append: 'px' }};
      }
      @media (992px <= width < 1200px) {
        height: {{ block.settings.height_md | append: 'px' }};
      }
      @media (768px <= width < 992px) {
        height: {{ block.settings.height_sm | append: 'px' }};
      }
      @media (width < 768px) {
        height: {{ block.settings.height_xs | append: 'px' }};
      }
    {% endif %}

    {% unless block.settings.lg_screens %}
      @media (width >= 1200px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.md_screens %}
      @media (992px <= width < 1200px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.sm_screens %}
      @media (768px <= width < 992px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.xs_screens %}
      @media (width < 768px) {
        display: none;
      }
    {% endunless %}
  }

  {% if block.settings.custom_css != blank %}
    #youcan-block--{{ block.id }} [data-lego="spacer"] {
      {{ block.settings.custom_css }}
    }
  {% endif %}
</style>

{% schema %}
{
  "label": "Spacer",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Design" },
    { "type": "number", "id": "height", "label": "Height", "default": 40 },
    { "type": "checkbox", "id": "customize_by_breakpoint", "label": "Different height per screen size", "default": false },
    {
      "type": "number",
      "id": "height_lg",
      "label": "Height on large screens",
      "default": 40,
      "visible_if": { "setting_id": "customize_by_breakpoint", "value": true }
    },
    {
      "type": "number",
      "id": "height_md",
      "label": "Height on medium screens",
      "default": 32,
      "visible_if": { "setting_id": "customize_by_breakpoint", "value": true }
    },
    {
      "type": "number",
      "id": "height_sm",
      "label": "Height on small screens",
      "default": 24,
      "visible_if": { "setting_id": "customize_by_breakpoint", "value": true }
    },
    {
      "type": "number",
      "id": "height_xs",
      "label": "Height on extra small screens",
      "default": 16,
      "visible_if": { "setting_id": "customize_by_breakpoint", "value": true }
    },
    { "type": "range", "id": "opacity", "label": "Opacity", "max": 1, "min": 0, "step": 0.1, "default": 1 },

    { "type": "header", "content": "Background" },
    { "type": "paragraph", "content": "Optional, turns the gap into a colored section-break band" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Single color", "value": "single-color" },
        { "label": "Gradient", "value": "gradient" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F5",
      "visible_if": { "setting_id": "background", "value": "single-color" }
    },
    {
      "type": "range",
      "id": "gradient_angle_degree",
      "label": "Angle degree",
      "min": 0,
      "step": 1,
      "max": 360,
      "unit": "°",
      "default": 90,
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#DDDDDD",
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#FFFFFF",
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },

    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "lg_screens", "label": "Show on large screens", "default": true },
    { "type": "paragraph", "content": "1200px and wider" },
    { "type": "checkbox", "id": "md_screens", "label": "Show on medium screens", "default": true },
    { "type": "paragraph", "content": "992px - 1199px" },
    { "type": "checkbox", "id": "sm_screens", "label": "Show on small screens", "default": true },
    { "type": "paragraph", "content": "768px - 991px" },
    { "type": "checkbox", "id": "xs_screens", "label": "Show on extra small screens", "default": true },
    { "type": "paragraph", "content": "767px and smaller" },

    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "placeholder": "my-spacer" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "placeholder": "transform: scale(2);\nbackdrop-filter: blur(2px);" }
  ]
}
{% endschema %}
