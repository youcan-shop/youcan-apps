{% if block.settings.page.slug == page.slug %}
  {% assign total_score = 0 %}
  {% assign review_count = 0 %}
  {% for i in (1..8) %}
    {% assign text_key = 'text_' | append: i %}
    {% assign rating_key = 'rating_' | append: i %}
    {% if block.settings[text_key] != blank %}
      {% assign total_score = total_score | plus: block.settings[rating_key] %}
      {% assign review_count = review_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% if review_count > 0 %}
    {% assign average_score = total_score | divided_by: review_count | divided_by: 1.0 %}
  {% endif %}

  <lego-reviews
    data-lego="reviews"
    {% if block.settings.anchor %}
      id="{{ block.settings.anchor }}"
    {% endif %}
  >
    {% if block.settings.show_summary and review_count > 0 %}
      <div class="summary">
        <span class="score">{{ average_score | round: 1 }}</span>
        <div class="stars">
          {% for s in (1..5) -%}
            <span class="material-symbols-rounded star" data-filled="{% if s <= average_score %}true{% else %}false{% endif %}">star</span>
          {%- endfor %}
        </div>
        <span class="count">
          {{- review_count }}
          {{ block.settings.reviews_label -}}
        </span>
      </div>
    {% endif %}

    <div class="list" data-layout="{{ block.settings.layout }}">
      {% for i in (1..8) %}
        {% assign text_key = 'text_' | append: i %}
        {% assign author_key = 'author_' | append: i %}
        {% assign date_key = 'date_' | append: i %}
        {% assign rating_key = 'rating_' | append: i %}
        {% assign verified_key = 'verified_' | append: i %}
        {% if block.settings[text_key] != blank %}
          <div class="review">
            <div class="stars">
              {% for s in (1..5) -%}
                <span class="material-symbols-rounded star" data-filled="{% if s <= block.settings[rating_key] %}true{% else %}false{% endif %}"
                  >star</span
                >
              {%- endfor %}
            </div>
            <p class="text">{{ block.settings[text_key] }}</p>
            <div class="meta">
              {% if block.settings[author_key] != blank %}
                <span class="author">
                  {{ block.settings[author_key] }}
                  {% if block.settings[verified_key] -%}
                    <span class="material-symbols-rounded verified">verified</span>
                  {%- endif %}
                </span>
              {% endif %}
              {% if block.settings[date_key] != blank -%}
                <span class="date">{{ block.settings[date_key] }}</span>
              {%- endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </lego-reviews>

  <style>
    #youcan-block--{{ block.id }} [data-lego="reviews"] {
      display: block;
      opacity: {{ block.settings.opacity }};

      margin-top: {{ block.settings.margin_top | append: 'px' }};
      margin-right: {{ block.settings.margin_right | append: 'px' }};
      margin-bottom: {{ block.settings.margin_bottom | append: 'px' }};
      margin-left: {{ block.settings.margin_left | append: 'px' }};
      padding-top: {{ block.settings.padding_top | append: 'px' }};
      padding-right: {{ block.settings.padding_right | append: 'px' }};
      padding-bottom: {{ block.settings.padding_bottom | append: 'px' }};
      padding-left: {{ block.settings.padding_left | append: 'px' }};

      border-top-left-radius: {{ block.settings.border_radius_tl | append: 'px' }};
      border-top-right-radius: {{ block.settings.border_radius_tr | append: 'px' }};
      border-bottom-right-radius: {{ block.settings.border_radius_br | append: 'px' }};
      border-bottom-left-radius: {{ block.settings.border_radius_bl | append: 'px' }};
      {% if block.settings.border_style != 'none' %}
        border: {{ block.settings.border_weight | append: 'px' }} {{ block.settings.border_style }} {{ block.settings.border_color.hex }};
      {% endif %}

      {% case block.settings.background %}
        {% when 'single-color' %}
          {% unless block.settings.bg_transparent %}background-color: {{ block.settings.bg_color.hex }};{% endunless %}
        {% when 'gradient' %}
          background-image: linear-gradient({{ block.settings.gradient_angle_degree }}deg, {{ block.settings.gradient_start.hex }}, {{ block.settings.gradient_end.hex }});
      {% endcase %}

      .summary {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid {{ block.settings.divider_color.hex }};

        {% if block.settings.font_family == 'custom' %}
          font-family: {{ block.settings.custom_font_family | replace: '+', ' ' }}, sans-serif, yc-sans;
        {% elsif block.settings.font_family != 'inherit' %}
          font-family: {{ block.settings.font_family }};
        {% endif %}

        .score { font-family: inherit; font-size: {{ block.settings.score_size }}px; font-weight: 600; color: {{ block.settings.text_color.hex }}; }
        .count { font-family: inherit; font-size: 13px; color: {{ block.settings.meta_color.hex }}; }
      }

      .stars {
        display: flex;
        gap: 2px;

        .star { font-size: 16px; color: {{ block.settings.star_color.hex }}; opacity: 0.25; }
        .star[data-filled="true"] { opacity: 1; }
      }

      .list {
        display: flex;
        flex-direction: column;
        gap: 20px;

        &[data-layout="grid"] {
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: {{ block.settings.gap }}px;

          @media (width <= 640px) { grid-template-columns: 1fr; }
        }
      }

      .review {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-bottom: 20px;
        border-bottom: 1px solid {{ block.settings.item_divider_color.hex }};

        .list[data-layout="grid"] & {
          border: 1px solid {{ block.settings.item_divider_color.hex }};
          border-radius: {{ block.settings.card_radius }}px;
          padding: 16px;
        }

        .text { 
          margin: 0; 
          font-size: {{ block.settings.text_size }}px; 
          color: {{ block.settings.text_color.hex }}; 
          line-height: 1.6;
        
          {% if block.settings.font_family == 'custom' %}
            font-family: {{ block.settings.custom_font_family | replace: '+', ' ' }}, sans-serif, yc-sans;
          {% elsif block.settings.font_family != 'inherit' %}
            font-family: {{ block.settings.font_family }};
          {% endif %}
        }

        .meta {
          display: flex;
          gap: 8px;
          align-items: center;
          font-size: 12px;
          color: {{ block.settings.meta_color.hex }};

          {% if block.settings.font_family == 'custom' %}
            font-family: {{ block.settings.custom_font_family | replace: '+', ' ' }}, sans-serif, yc-sans;
          {% elsif block.settings.font_family != 'inherit' %}
            font-family: {{ block.settings.font_family }};
          {% endif %}

          .author { display: inline-flex; align-items: center; gap: 3px; font-weight: 500; font-family: inherit; }
          .verified { font-size: 13px; color: {{ block.settings.verified_color.hex }}; }
          .date { font-family: inherit;}
        }
      }

      .material-symbols-rounded {
        font-variation-settings: "FILL" 1, "wght" 400, "GRAD" 0, "opsz" 20;
      }

      {% unless block.settings.lg_screens %}@media (width >= 1200px) { display: none; }{% endunless %}
      {% unless block.settings.md_screens %}@media (992px <= width < 1200px) { display: none; }{% endunless %}
      {% unless block.settings.sm_screens %}@media (768px <= width < 992px) { display: none; }{% endunless %}
      {% unless block.settings.xs_screens %}@media (width < 768px) { display: none; }{% endunless %}
    }

    {% if block.settings.custom_css != blank %}
      #youcan-block--{{ block.id }} [data-lego="reviews"] {
        {{ block.settings.custom_css }}
      }
    {% endif %}
  </style>
{% endif %}

