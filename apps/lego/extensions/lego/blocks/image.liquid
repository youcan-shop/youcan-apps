{% assign fallback_image_url = 'default-fallback-image.webp' | asset_url %}

{% if block.settings.clickable %}
  <a
    data-lego="image"
    href="{{ block.settings.url | default: '#' }}"
    {% if block.settings.new_window %}
      target="_blank"
    {% endif %}
  >
{% endif %}
<img
  data-lego="image"
  {% if block.settings.anchor %}
    id="{{ block.settings.anchor }}"
  {% endif %}
  {% if block.settings.source == 'static' %}
    src="{{ block.settings.image.src | default: fallback_image_url }}"
  {% else %}
    {% case block.settings.dynamic_source %}
      {% when 'product-title' %}
        src="{{ product.preview_image.original | default: fallback_image_url }}"
      {% when 'collection-title' %}
        src="{{ category.image | default: fallback_image_url }}"
    {% endcase %}
  {% endif %}
  width="100%"
  height="100%"
  {% if block.settings.loading %}
    loading="{{ block.settings.loading }}"
  {% endif %}
  alt="{{ block.settings.alt |  default: category.name | default: product.name | default: 'My image' }}"
/>
{% if block.settings.clickable %}
  </a>
{% endif %}

<style>
  #youcan-block--{{ block.id }} [data-lego="image"] {
    padding: {{ block.settings.padding | append: 'px' }};
    margin: {{ block.settings.margin | append: 'px' }};
    border-radius: {{ block.settings.border_radius | append: 'px' }};
    border: {{ block.settings.border_weight | append: 'px' }} {{ block.settings.border_style }} {{ block.settings.border_color.hex }};
    opacity: {{ block.settings.opacity }};
    object-fit: {{ block.settings.object_fit }};
    aspect-ratio: {{ block.settings.aspect_ratio }};

    {% if block.settings.width == 'custom' %}
      max-width: 100%;
      width: {{ block.settings.custom_width | append: 'px' }};
    {% endif %}

    {% unless block.settings.lg_screens %}
      @media (width >= 1200px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.md_screens %}
      @media (992px <= width < 1200px)  {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.sm_screens %}
      @media (768px <= width < 992px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.xs_screens %}
      @media (width < 768px) {
        display: none;
      }
    {% endunless %}
  }

  {% if block.settings.custom_css != 'blank' %}
    #youcan-block--{{ block.id }} [data-lego="image"] {
      {{ block.settings.custom_css }}
    }
  {% endif %}
</style>

{% schema %}
{
  "label": "Image",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "label": "Static", "value": "static" },
        { "label": "Dynamic", "value": "dynamic" }
      ],
      "default": "static"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": { "setting_id": "source", "value": "static" }
    },
    {
      "type": "select",
      "id": "dynamic_source",
      "label": "Image source",
      "options": [
        { "label": "Product image", "value": "product-image" },
        { "label": "Collection image", "value": "collection-image" }
      ],
      "default": "product-image",
      "visible_if": { "setting_id": "source", "value": "dynamic" }
    },
    { "type": "text", "id": "alt", "label": "Alt" },
    { "type": "checkbox", "id": "clickable", "label": "Image is clickable", "default": false },
    {
      "type": "text",
      "id": "url",
      "label": "URL",
      "default": "https://youcan.shop",
      "visible_if": { "setting_id": "clickable", "value": true }
    },
    {
      "type": "checkbox",
      "id": "new_window",
      "label": "Open in new window",
      "default": false,
      "visible_if": { "setting_id": "clickable", "value": true }
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Aspect ratio",
      "options": [
        { "label": "Auto", "value": "auto" },
        { "label": "Square (1:1)", "value": "1 / 1" },
        { "label": "Landscape (4:3)", "value": "4 / 3" },
        { "label": "Portrait (3:4)", "value": "3 / 4" },
        { "label": "Widescreen (16:9)", "value": "16 / 9" },
        { "label": "Ultrawide (21:9)", "value": "21 / 9" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "object_fit",
      "label": "Object fit",
      "options": [
        { "label": "Cover", "value": "cover" },
        { "label": "Contain", "value": "contain" },
        { "label": "Fill", "value": "fill" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "label": "Full width", "value": "full" },
        { "label": "Custom", "value": "custom" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "max": 1920,
      "min": 320,
      "step": 20,
      "unit": "px",
      "default": 1200,
      "visible_if": { "setting_id": "width", "value": "custom" }
    },
    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "margin", "label": "Margin", "default": 0 },
    { "type": "number", "id": "padding", "label": "Padding", "default": 0 },
    { "type": "header", "content": "Design" },
    { "type": "number", "id": "border_weight", "label": "Border weight", "default": 0 },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border style",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Solid", "value": "solid" },
        { "label": "Dashed", "value": "dashed" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#121212" },
    { "type": "number", "id": "border_radius", "label": "Border radius", "default": 0 },
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "lg_screens", "label": "Show on large screens", "default": true },
    { "type": "paragraph", "content": "1200px and wider" },
    { "type": "checkbox", "id": "md_screens", "label": "Show on medium screens", "default": true },
    { "type": "paragraph", "content": "992px - 1199px" },
    { "type": "checkbox", "id": "sm_screens", "label": "Show on small screens", "default": true },
    { "type": "paragraph", "content": "768px - 991px" },
    { "type": "checkbox", "id": "xs_screens", "label": "Show on extra small screens", "default": true },
    { "type": "paragraph", "content": "769px and smaller" },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity",
      "max": 1,
      "min": 0,
      "step": 0.1,
      "default": 1
    },
    { "type": "header", "content": "Advanced" },
    {
      "type": "select",
      "id": "loading",
      "label": "Loading",
      "options": [
        { "label": "Eager", "value": "eager" },
        { "label": "Lazy", "value": "lazy" },
        { "label": "Auto", "value": "" }
      ],
      "default": ""
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "placeholder": "my-image"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "placeholder": "transform: scale(2);\nbackdrop-filter: filter(2px);"
    }
  ]
}
{% endschema %}
