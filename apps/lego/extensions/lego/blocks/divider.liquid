{% if block.settings.page.slug == page.slug %}
  {% if block.settings.label %}
    <div
      data-lego="divider"
      data-has-label="true"
      {% if block.settings.anchor %}
        id="{{ block.settings.anchor }}"
      {% endif %}
    >
      <span data-lego="divider-label">{{ block.settings.label }}</span>
    </div>
  {% else %}
    <hr
      data-lego="divider"
      {% if block.settings.anchor %}
        id="{{ block.settings.anchor }}"
      {% endif %}
    >
  {% endif %}

  <style>
    #youcan-block--{{ block.id }} [data-lego="divider"] {
      border: none;
      opacity: {{ block.settings.opacity }};

      margin-top: {{ block.settings.margin_top | append: 'px' }};
      margin-right: {{ block.settings.margin_right | append: 'px' }};
      margin-bottom: {{ block.settings.margin_bottom | append: 'px' }};
      margin-left: {{ block.settings.margin_left | append: 'px' }};

      {% if block.settings.orientation == 'horizontal' %}
        border-top: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        {% if block.settings.width == 'custom' %}
          max-width: 100%;
          width: {{ block.settings.custom_width | append: 'px' }};
        {% else %}
          width: 100%;
        {% endif %}
        {% if block.settings.width == 'custom' %}
          {% if block.settings.align == 'center' %}margin-inline: auto;{% endif %}
          {% if block.settings.align == 'right' %}margin-inline-start: auto;{% endif %}
        {% endif %}
      {% else %}
        display: inline-block;
        border-left: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        height: {{ block.settings.vertical_length }}px;
      {% endif %}

      {% if block.settings.fade_edges %}
        -webkit-mask-image: linear-gradient(
          {% if block.settings.orientation == 'horizontal' %}to right{% else %}to bottom{% endif %},
          transparent, black 20%, black 80%, transparent
        );
        mask-image: linear-gradient(
          {% if block.settings.orientation == 'horizontal' %}to right{% else %}to bottom{% endif %},
          transparent, black 20%, black 80%, transparent
        );
      {% endif %}

      &[data-has-label="true"] {
        display: flex;
        align-items: center;
        gap: 12px;
        border: none;
        color: {{ block.settings.label_color.hex }};
        font-size: {{ block.settings.label_size }}px;

        &::before,
        &::after {
          content: "";
          flex: 1;
          border-top: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        }
      }

      {% unless block.settings.lg_screens %}
        @media (width >= 1200px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.md_screens %}
        @media (992px <= width < 1200px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.sm_screens %}
        @media (768px <= width < 992px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.xs_screens %}
        @media (width < 768px) {
          display: none;
        }
      {% endunless %}
    }

    {% if block.settings.custom_css != blank %}
      #youcan-block--{{ block.id }} [data-lego="divider"] {
        {{ block.settings.custom_css }}
      }
    {% endif %}
  </style>
{% endif %}

{% schema %}
{
  "label": "t:blocks.divider.label",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.divider.settings.applies_to.label"
    },
    {
      "type": "page",
      "id": "page",
      "label": "t:blocks.divider.settings.applies_to.page"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.divider.settings.applies_to.paragraph"
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.content.label"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.divider.settings.content.label_setting.label",
      "placeholder": "t:blocks.divider.settings.content.label_setting.placeholder"
    },
    {
      "type": "range",
      "id": "label_size",
      "label": "t:blocks.divider.settings.content.label_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13,
      "visible_if": {
        "setting_id": "label",
        "operator": "!=",
        "value": ""
      }
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "t:blocks.divider.settings.content.label_color",
      "default": "#6B7280",
      "visible_if": {
        "setting_id": "label",
        "operator": "!=",
        "value": ""
      }
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.design.label"
    },
    {
      "type": "select",
      "id": "orientation",
      "label": "t:blocks.divider.settings.design.orientation.label",
      "options": [
        {
          "label": "t:blocks.divider.settings.design.orientation.options.horizontal",
          "value": "horizontal"
        },
        {
          "label": "t:blocks.divider.settings.design.orientation.options.vertical",
          "value": "vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.divider.settings.design.style.label",
      "options": [
        {
          "label": "t:blocks.divider.settings.design.style.options.solid",
          "value": "solid"
        },
        {
          "label": "t:blocks.divider.settings.design.style.options.dashed",
          "value": "dashed"
        },
        {
          "label": "t:blocks.divider.settings.design.style.options.dotted",
          "value": "dotted"
        },
        {
          "label": "t:blocks.divider.settings.design.style.options.double",
          "value": "double"
        }
      ],
      "default": "solid"
    },
    {
      "type": "number",
      "id": "thickness",
      "label": "t:blocks.divider.settings.design.thickness",
      "default": 2
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:blocks.divider.settings.design.color",
      "default": "#121212"
    },
    {
      "type": "checkbox",
      "id": "fade_edges",
      "label": "t:blocks.divider.settings.design.fade_edges",
      "default": false
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.layout.label"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:blocks.divider.settings.layout.width.label",
      "options": [
        {
          "label": "t:blocks.divider.settings.layout.width.options.full",
          "value": "full"
        },
        {
          "label": "t:blocks.divider.settings.layout.width.options.custom",
          "value": "custom"
        }
      ],
      "default": "full",
      "visible_if": {
        "setting_id": "orientation",
        "value": "horizontal"
      }
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:blocks.divider.settings.layout.custom_width",
      "max": 1920,
      "min": 40,
      "step": 20,
      "unit": "px",
      "default": 400,
      "visible_if": {
        "setting_id": "width",
        "value": "custom"
      }
    },
    {
      "type": "select",
      "id": "align",
      "label": "t:blocks.divider.settings.layout.align.label",
      "options": [
        {
          "label": "t:blocks.divider.settings.layout.align.options.left",
          "value": "left"
        },
        {
          "label": "t:blocks.divider.settings.layout.align.options.center",
          "value": "center"
        },
        {
          "label": "t:blocks.divider.settings.layout.align.options.right",
          "value": "right"
        }
      ],
      "default": "center",
      "visible_if": {
        "setting_id": "width",
        "value": "custom"
      }
    },
    {
      "type": "range",
      "id": "vertical_length",
      "label": "t:blocks.divider.settings.layout.vertical_length",
      "min": 8,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": {
        "setting_id": "orientation",
        "value": "vertical"
      }
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.spacing.label"
    },
    {
      "type": "number",
      "id": "margin_top",
      "label": "t:blocks.divider.settings.spacing.margin_top",
      "default": 16
    },
    {
      "type": "number",
      "id": "margin_right",
      "label": "t:blocks.divider.settings.spacing.margin_right",
      "default": 0
    },
    {
      "type": "number",
      "id": "margin_bottom",
      "label": "t:blocks.divider.settings.spacing.margin_bottom",
      "default": 16
    },
    {
      "type": "number",
      "id": "margin_left",
      "label": "t:blocks.divider.settings.spacing.margin_left",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.visibility.label"
    },
    {
      "type": "checkbox",
      "id": "lg_screens",
      "label": "t:blocks.divider.settings.visibility.lg_screens",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:blocks.divider.settings.visibility.paragraph"
    },
    {
      "type": "checkbox",
      "id": "md_screens",
      "label": "t:blocks.divider.settings.visibility.md_screens",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:blocks.divider.settings.visibility.paragraph_2"
    },
    {
      "type": "checkbox",
      "id": "sm_screens",
      "label": "t:blocks.divider.settings.visibility.sm_screens",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:blocks.divider.settings.visibility.paragraph_3"
    },
    {
      "type": "checkbox",
      "id": "xs_screens",
      "label": "t:blocks.divider.settings.visibility.xs_screens",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:blocks.divider.settings.visibility.paragraph_4"
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "t:blocks.divider.settings.visibility.opacity",
      "max": 1,
      "min": 0,
      "step": 0.1,
      "default": 1
    },
    {
      "type": "header",
      "content": "t:blocks.divider.settings.advanced.label"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:blocks.divider.settings.advanced.anchor.label",
      "placeholder": "t:blocks.divider.settings.advanced.anchor.placeholder"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "t:blocks.divider.settings.advanced.custom_css.label",
      "placeholder": "t:blocks.divider.settings.advanced.custom_css.placeholder"
    }
  ]
}
{% endschema %}
