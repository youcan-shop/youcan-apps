{% if block.settings.page.slug == page.slug %}
  {% if block.settings.label != blank %}
    <div
      data-lego="divider"
      data-has-label="true"
      {% if block.settings.anchor %}
        id="{{ block.settings.anchor }}"
      {% endif %}
    >
      <span data-lego="divider-label">{{ block.settings.label }}</span>
    </div>
  {% else %}
    <hr
      data-lego="divider"
      {% if block.settings.anchor %}
        id="{{ block.settings.anchor }}"
      {% endif %}
    >
  {% endif %}

  <style>
    #youcan-block--{{ block.id }} [data-lego="divider"] {
      border: none;
      opacity: {{ block.settings.opacity }};

      margin-top: {{ block.settings.margin_top | append: 'px' }};
      margin-right: {{ block.settings.margin_right | append: 'px' }};
      margin-bottom: {{ block.settings.margin_bottom | append: 'px' }};
      margin-left: {{ block.settings.margin_left | append: 'px' }};

      {% if block.settings.orientation == 'horizontal' %}
        border-top: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        {% if block.settings.width == 'custom' %}
          max-width: 100%;
          width: {{ block.settings.custom_width | append: 'px' }};
        {% else %}
          width: 100%;
        {% endif %}
        {% if block.settings.width == 'custom' %}
          {% if block.settings.align == 'center' %}margin-inline: auto;{% endif %}
          {% if block.settings.align == 'right' %}margin-inline-start: auto;{% endif %}
        {% endif %}
      {% else %}
        display: inline-block;
        border-left: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        height: {{ block.settings.vertical_length }}px;
      {% endif %}

      {% if block.settings.fade_edges %}
        -webkit-mask-image: linear-gradient(
          {% if block.settings.orientation == 'horizontal' %}to right{% else %}to bottom{% endif %},
          transparent, black 20%, black 80%, transparent
        );
        mask-image: linear-gradient(
          {% if block.settings.orientation == 'horizontal' %}to right{% else %}to bottom{% endif %},
          transparent, black 20%, black 80%, transparent
        );
      {% endif %}

      &[data-has-label="true"] {
        display: flex;
        align-items: center;
        gap: 12px;
        border: none;
        color: {{ block.settings.label_color.hex }};
        font-size: {{ block.settings.label_size }}px;

        &::before,
        &::after {
          content: "";
          flex: 1;
          border-top: {{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color.hex }};
        }
      }

      {% unless block.settings.lg_screens %}
        @media (width >= 1200px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.md_screens %}
        @media (992px <= width < 1200px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.sm_screens %}
        @media (768px <= width < 992px) {
          display: none;
        }
      {% endunless %}
      {% unless block.settings.xs_screens %}
        @media (width < 768px) {
          display: none;
        }
      {% endunless %}
    }

    {% if block.settings.custom_css != blank %}
      #youcan-block--{{ block.id }} [data-lego="divider"] {
        {{ block.settings.custom_css }}
      }
    {% endif %}
  </style>
{% endif %}

{% schema %}
{
  "label": "Divider",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Applies to" },
    { "type": "page", "id": "page", "label": "Page" },
    { "type": "paragraph", "content": "You can't see your block without selecting a specific page." },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "label", "label": "Center label (optional)", "placeholder": "OR" },
    {
      "type": "range",
      "id": "label_size",
      "label": "Label size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 13,
      "visible_if": { "setting_id": "label", "operator": "!=", "value": "" }
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#6B7280",
      "visible_if": { "setting_id": "label", "operator": "!=", "value": "" }
    },

    { "type": "header", "content": "Design" },
    {
      "type": "select",
      "id": "orientation",
      "label": "Orientation",
      "options": [
        { "label": "Horizontal", "value": "horizontal" },
        { "label": "Vertical", "value": "vertical" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Line style",
      "options": [
        { "label": "Solid", "value": "solid" },
        { "label": "Dashed", "value": "dashed" },
        { "label": "Dotted", "value": "dotted" },
        { "label": "Double", "value": "double" }
      ],
      "default": "solid"
    },
    { "type": "number", "id": "thickness", "label": "Thickness", "default": 2 },
    { "type": "color", "id": "color", "label": "Color", "default": "#121212" },
    { "type": "checkbox", "id": "fade_edges", "label": "Fade edges", "default": false },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "label": "Full width", "value": "full" },
        { "label": "Custom", "value": "custom" }
      ],
      "default": "full",
      "visible_if": { "setting_id": "orientation", "value": "horizontal" }
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "max": 1920,
      "min": 40,
      "step": 20,
      "unit": "px",
      "default": 400,
      "visible_if": { "setting_id": "width", "value": "custom" }
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" }
      ],
      "default": "center",
      "visible_if": { "setting_id": "width", "value": "custom" }
    },
    {
      "type": "range",
      "id": "vertical_length",
      "label": "Length",
      "min": 8,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": { "setting_id": "orientation", "value": "vertical" }
    },

    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "margin_top", "label": "Margin top", "default": 16 },
    { "type": "number", "id": "margin_right", "label": "Margin right", "default": 0 },
    { "type": "number", "id": "margin_bottom", "label": "Margin bottom", "default": 16 },
    { "type": "number", "id": "margin_left", "label": "Margin left", "default": 0 },

    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "lg_screens", "label": "Show on large screens", "default": true },
    { "type": "paragraph", "content": "1200px and wider" },
    { "type": "checkbox", "id": "md_screens", "label": "Show on medium screens", "default": true },
    { "type": "paragraph", "content": "992px - 1199px" },
    { "type": "checkbox", "id": "sm_screens", "label": "Show on small screens", "default": true },
    { "type": "paragraph", "content": "768px - 991px" },
    { "type": "checkbox", "id": "xs_screens", "label": "Show on extra small screens", "default": true },
    { "type": "paragraph", "content": "767px and smaller" },
    { "type": "range", "id": "opacity", "label": "Opacity", "max": 1, "min": 0, "step": 0.1, "default": 1 },

    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "placeholder": "my-divider" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "placeholder": "transform: scale(2);\nbackdrop-filter: blur(2px);" }
  ]
}
{% endschema %}
