        "value": "gradient"
      }
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "t:blocks.product_card.settings.background.gradient_end",
      "default": "#F3F4F6",
      "visible_if": {
        "setting_id": "background",
        "value": "gradient"
      }
    },
    {
      "type": "header",
      "content": "t:blocks.product_card.settings.border.label"
    },
    {
      "type": "number",
      "id": "border_weight",
      "label": "t:blocks.product_card.settings.border.border_weight",
      "default": 0
    },
    {
      "type": "select",
      "id": "border_style",
      "label": "t:blocks.product_card.settings.border.border_style.label",
      "options": [
        {
          "label": "t:blocks.product_card.settings.border.border_style.options.none",
          "value": "none"
        },
        {
          "label": "t:blocks.product_card.settings.border.border_style.options.solid",
          "value": "solid"
        },
        {
          "label": "t:blocks.product_card.settings.border.border_style.options.dashed",
          "value": "dashed"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:blocks.product_card.settings.border.border_color",
      "default": "#E5E7EB"
    },
    {
      "type": "number",
      "id": "border_radius_tl",
      "label": "t:blocks.product_card.settings.border.border_radius_tl",
      "default": 0
