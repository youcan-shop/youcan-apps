      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "t:blocks.product_card.settings.style.price_color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "compare_color",
      "label": "t:blocks.product_card.settings.style.compare_color",
      "default": "#9CA3AF"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "t:blocks.product_card.settings.style.badge_bg_color",
