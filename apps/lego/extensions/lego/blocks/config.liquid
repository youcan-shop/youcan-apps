{% if template.name == 'page' %}
  <script id="lego-app-config">
    (function () {
      let hideIds = ['youcan-section--page'];

      {% if block.settings.hide_announcement_bar %}
        hideIds.push('youcan-section--announcement-bar', 'youcan-section--announcement-banner', 'youcan-section--notice-bar');
      {% endif %}
      {% if block.settings.hide_header %}
        hideIds.push('youcan-section--header', 'youcan-section--main-navbar');
      {% endif %}
      {% if block.settings.hide_footer %}
        hideIds.push('youcan-section--footer', 'youcan-section--main-footer');
      {% endif %}

      let style = document.createElement('style');
      style.id = 'lego-app-config-hidden-sections';
      style.textContent = hideIds.map(function (id) {
        return '#' + id + ' { display: none !important; }';
      }).join('\n');
      document.head.appendChild(style);
    })();
  </script>

  {% if block.settings.page_width != 'full' %}
    {% case block.settings.page_width %}
      {% when 'tablet' %}
        {% assign page_max_width = 768 %}
      {% when 'mobile' %}
        {% assign page_max_width = 480 %}
      {% when 'custom' %}
        {% assign page_max_width = block.settings.page_width_custom %}
    {% endcase %}
    <style id="lego-app-config-page-width">
      [id^="youcan-block--"] {
        max-width: {{ page_max_width }}px;
        margin-inline: auto;
      }
    </style>
  {% endif %}

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0..1,0"
  />
{% endif %}

{% schema %}
{
  "label": "t:blocks.config.label",
  "target": "body",
  "settings": [
    {
      "type": "header",
      "content": "t:blocks.config.settings.page_width.label"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "t:blocks.config.settings.page_width.page_width.label",
      "options": [
        {
          "label": "t:blocks.config.settings.page_width.page_width.options.full",
          "value": "full"
        },
        {
          "label": "t:blocks.config.settings.page_width.page_width.options.tablet",
          "value": "tablet"
        },
        {
          "label": "t:blocks.config.settings.page_width.page_width.options.mobile",
          "value": "mobile"
        },
        {
          "label": "t:blocks.config.settings.page_width.page_width.options.custom",
          "value": "custom"
        }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "page_width_custom",
      "label": "t:blocks.config.settings.page_width.page_width_custom",
      "min": 360,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 600,
      "visible_if": {
        "setting_id": "page_width",
        "value": "custom"
      }
    },
    {
      "type": "header",
      "content": "t:blocks.config.settings.hide_theme_sections.label"
    },
    {
      "type": "checkbox",
      "id": "hide_announcement_bar",
      "label": "t:blocks.config.settings.hide_theme_sections.hide_announcement_bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_header",
      "label": "t:blocks.config.settings.hide_theme_sections.hide_header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_footer",
      "label": "t:blocks.config.settings.hide_theme_sections.hide_footer",
      "default": true
    }
  ]
}
{% endschema %}
