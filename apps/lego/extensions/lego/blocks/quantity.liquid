{% assign product = block.settings.product | default: product %}

{% if product %}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,1,0&icon_names=remove,add"
  />

  {% assign default_variant = product.selected_or_first_available_variant %}

  <lego-quantity
    data-lego="quantity"
    data-product-id="{{ product.id }}"
    data-style="{{ block.settings.style }}"
    data-min="{{ block.settings.min_value }}"
    data-max="{{ block.settings.max_value }}"
    data-step="{{ block.settings.step_value }}"
    data-default-inventory="{{ default_variant.inventory }}"
    data-respect-inventory="{{ block.settings.respect_inventory }}"
    {% if block.settings.anchor %}
      id="{{ block.settings.anchor }}"
    {% endif %}
  >
    <div class="row" data-position="{{ block.settings.label_position }}">
      {% if block.settings.label != blank -%}
        <span class="label">{{ block.settings.label }}</span>
      {%- endif %}

      {% case block.settings.style %}
        {% when 'stepper' %}
          <div class="stepper">
            <button type="button" class="step" data-slot="dec" aria-label="Decrease"><span class="material-symbols-rounded">remove</span></button>
            <input
              type="number"
              class="value-input"
              data-slot="input"
              value="{{ block.settings.min_value }}"
              min="{{ block.settings.min_value }}"
              max="{{ block.settings.max_value }}"
              step="{{ block.settings.step_value }}"
              inputmode="numeric"
              {% unless block.settings.input_editable %}
                readonly
              {% endunless %}
            >
            <button type="button" class="step" data-slot="inc" aria-label="Increase"><span class="material-symbols-rounded">add</span></button>
          </div>
        {% when 'input' %}
          <input
            type="number"
            class="value-input plain"
            data-slot="input"
            value="{{ block.settings.min_value }}"
            min="{{ block.settings.min_value }}"
            max="{{ block.settings.max_value }}"
            step="{{ block.settings.step_value }}"
            inputmode="numeric"
          >
        {% when 'dropdown' %}
          <select class="dropdown" data-slot="input">
            {% assign i = block.settings.min_value %}
            {% for n in (1..50) %}
              {% if i > block.settings.max_value %}{% break %}{% endif %}
              <option
                value="{{ i }}"
                {% if i == block.settings.min_value %}
                  selected
                {% endif %}
              >
                {{ i }}
              </option>
              {% assign i = i | plus: block.settings.step_value %}
            {% endfor %}
          </select>
      {% endcase %}
    </div>

    {% if block.settings.show_max_message %}
      <p class="max-message" data-slot="max-message" hidden>{{ block.settings.max_message }}</p>
    {% endif %}
  </lego-quantity>
{% endif %}

<style>
  #youcan-block--{{ block.id }} [data-lego="quantity"] {
    display: block;
    opacity: {{ block.settings.opacity }};

    margin-top: {{ block.settings.margin_top | append: 'px' }};
    margin-right: {{ block.settings.margin_right | append: 'px' }};
    margin-bottom: {{ block.settings.margin_bottom | append: 'px' }};
    margin-left: {{ block.settings.margin_left | append: 'px' }};
    padding-top: {{ block.settings.padding_top | append: 'px' }};
    padding-right: {{ block.settings.padding_right | append: 'px' }};
    padding-bottom: {{ block.settings.padding_bottom | append: 'px' }};
    padding-left: {{ block.settings.padding_left | append: 'px' }};

    border-top-left-radius: {{ block.settings.border_radius_tl | append: 'px' }};
    border-top-right-radius: {{ block.settings.border_radius_tr | append: 'px' }};
    border-bottom-right-radius: {{ block.settings.border_radius_br | append: 'px' }};
    border-bottom-left-radius: {{ block.settings.border_radius_bl | append: 'px' }};
    {% if block.settings.border_style != 'none' %}
      border: {{ block.settings.border_weight | append: 'px' }} {{ block.settings.border_style }} {{ block.settings.border_color.hex }};
    {% endif %}

    {% case block.settings.background %}
      {% when 'single-color' %}
        {% unless block.settings.bg_transparent %}background-color: {{ block.settings.bg_color.hex }};{% endunless %}
      {% when 'gradient' %}
        background-image: linear-gradient({{ block.settings.gradient_angle_degree }}deg, {{ block.settings.gradient_start.hex }}, {{ block.settings.gradient_end.hex }});
    {% endcase %}

    .row {
      display: flex;
      align-items: center;
      gap: 12px;

      &[data-position="top"] { flex-direction: column; align-items: flex-start; }
    }

    .label { font-size: 13px; font-weight: 600; color: {{ block.settings.label_color.hex }}; }

    .stepper {
      display: inline-flex;
      align-items: center;
      border: 1px solid {{ block.settings.border_control_color.hex }};
      border-radius: {{ block.settings.control_radius }}px;
      overflow: hidden;

      .step {
        width: {{ block.settings.control_height }}px;
        height: {{ block.settings.control_height }}px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 0;
        padding: 0;
        border-radius: 0;
        cursor: pointer;
        color: {{ block.settings.text_color.hex }};
        transition: background-color 160ms ease, transform 160ms cubic-bezier(0.23, 1, 0.32, 1);

        .material-symbols-rounded { font-size: 18px; }

        &:active { transform: scale(0.9); }
        &:disabled { opacity: 0.35; cursor: not-allowed; }

        @media (hover: hover) and (pointer: fine) {
          &:hover:not(:disabled) { background-color: {{ block.settings.hover_bg_color.hex }}; }
        }
      }

      .value-input {
        min-width: {{ block.settings.input_width }}px;
        height: {{ block.settings.control_height }}px;
        border: 0;
        border-inline: 1px solid {{ block.settings.border_control_color.hex }};
        text-align: center;
        font: inherit;
        font-size: 14px;
        border-radius: 0;
        color: {{ block.settings.text_color.hex }};
        -moz-appearance: textfield;

        &::-webkit-outer-spin-button, &::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        &:focus { outline: none; }
        &[readonly] { background-color: transparent; cursor: default; }
      }
    }

    .value-input.plain, .dropdown {
      height: {{ block.settings.control_height }}px;
      padding: 0 12px;
      border-radius: {{ block.settings.control_radius }}px;
      border: 1px solid {{ block.settings.border_control_color.hex }};
      font: inherit;
      font-size: 14px;
      color: {{ block.settings.text_color.hex }};
      width: {{ block.settings.input_width | times: 2 }}px;
    }

    .max-message {
      margin: 6px 0 0;
      font-size: 12px;
      color: {{ block.settings.max_message_color.hex }};
    }

    {% unless block.settings.lg_screens %}@media (width >= 1200px) { display: none; }{% endunless %}
    {% unless block.settings.md_screens %}@media (992px <= width < 1200px) { display: none; }{% endunless %}
    {% unless block.settings.sm_screens %}@media (768px <= width < 992px) { display: none; }{% endunless %}
    {% unless block.settings.xs_screens %}@media (width < 768px) { display: none; }{% endunless %}
  }

  {% if block.settings.custom_css != blank %}
    #youcan-block--{{ block.id }} [data-lego="quantity"] {
      {{ block.settings.custom_css }}
    }
  {% endif %}
</style>

<script defer>
  if (!customElements.get('lego-quantity')) {
    class LegoQuantity extends HTMLElement {
      connectedCallback() {
        this.productId = this.getAttribute('data-product-id');
        this.min = Number(this.getAttribute('data-min')) || 1;
        this.max = Number(this.getAttribute('data-max')) || 999;
        this.step = Number(this.getAttribute('data-step')) || 1;
        this.respectInventory = this.getAttribute('data-respect-inventory') === '1';
        this.currentMax = this.max;

        if (this.respectInventory) {
          const defaultInventory = Number(this.getAttribute('data-default-inventory'));
          if (defaultInventory > 0) this.currentMax = Math.min(this.max, defaultInventory);
        }

        this.input = this.querySelector('[data-slot="input"]');
        this.decBtn = this.querySelector('[data-slot="dec"]');
        this.incBtn = this.querySelector('[data-slot="inc"]');
        this.maxMessage = this.querySelector('[data-slot="max-message"]');

        if (this.decBtn) this.decBtn.addEventListener('click', () => this.step_(-1));
        if (this.incBtn) this.incBtn.addEventListener('click', () => this.step_(1));
        if (this.input) {
          this.input.addEventListener('change', () => this.setValue(Number(this.input.value)));
          this.input.addEventListener('input', () => {
            if (this.input.tagName === 'SELECT') this.setValue(Number(this.input.value));
          });
        }

        if (this.respectInventory) {
          document.addEventListener('lego:variant:change', (e) => {
            if (!e.detail || e.detail.productId !== this.productId) return;
            this.setValue(Math.min(Number(this.input.value), this.currentMax));
          });
        }

        this.setValue(this.min, true);
      }

      step_(dir) {
        const current = Number(this.input.value) || this.min;
        this.setValue(current + dir * this.step);
      }

      setValue(value, silent) {
        let clamped = Math.max(this.min, Math.min(this.currentMax, value));
        this.input.value = clamped;

        if (this.decBtn) this.decBtn.disabled = clamped <= this.min;
        if (this.incBtn) this.incBtn.disabled = clamped >= this.currentMax;
        if (this.maxMessage) this.maxMessage.hidden = clamped < this.currentMax;

        if (!silent) {
          document.dispatchEvent(
            new CustomEvent('lego:quantity:change', {
              bubbles: true,
              detail: { productId: this.productId, quantity: clamped },
            })
          );
        }
      }
    }

    customElements.define('lego-quantity', LegoQuantity);
  }
</script>

{% schema %}
{
  "label": "Quantity",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product" },
    {
      "type": "paragraph",
      "content": "Uses the product on the current page, or pick one. Broadcasts changes for Add to Cart / Buy Box blocks placed elsewhere."
    },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "label", "label": "Label", "default": "Quantity" },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "options": [
        { "label": "Left of control", "value": "left" },
        { "label": "Above control", "value": "top" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Control style",
      "options": [
        { "label": "Stepper (- value +)", "value": "stepper" },
        { "label": "Plain number input", "value": "input" },
        { "label": "Dropdown", "value": "dropdown" }
      ],
      "default": "stepper"
    },
    {
      "type": "checkbox",
      "id": "input_editable",
      "label": "Allow typing a value directly",
      "default": true,
      "visible_if": { "setting_id": "style", "value": "stepper" }
    },

    { "type": "header", "content": "Limits" },
    { "type": "number", "id": "min_value", "label": "Minimum", "default": 1 },
    { "type": "number", "id": "max_value", "label": "Maximum", "default": 20 },
    { "type": "number", "id": "step_value", "label": "Step", "default": 1 },
    { "type": "checkbox", "id": "respect_inventory", "label": "Cap at available stock", "default": true },
    { "type": "checkbox", "id": "show_max_message", "label": "Show message at max", "default": true },
    {
      "type": "text",
      "id": "max_message",
      "label": "Max message",
      "default": "Maximum available quantity reached",
      "visible_if": { "setting_id": "show_max_message", "value": true }
    },
    { "type": "color", "id": "max_message_color", "label": "Max message color", "default": "#DC2626" },

    { "type": "header", "content": "Style" },
    { "type": "range", "id": "control_height", "label": "Control height", "min": 28, "max": 56, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "input_width", "label": "Value width", "min": 32, "max": 72, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "control_radius", "label": "Control corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1A1A1A" },
    { "type": "color", "id": "label_color", "label": "Label color", "default": "#374151" },
    { "type": "color", "id": "border_control_color", "label": "Control border color", "default": "#D1D5DB" },
    { "type": "color", "id": "hover_bg_color", "label": "Button hover background", "default": "#F5F5F5" },

    { "type": "header", "content": "Background" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Single color", "value": "single-color" },
        { "label": "Gradient", "value": "gradient" }
      ],
      "default": "none"
    },
    {
      "type": "checkbox",
      "id": "bg_transparent",
      "label": "Transparent background",
      "default": false,
      "visible_if": { "setting_id": "background", "value": "single-color" }
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F5F5F5",
      "visible_if": [
        { "setting_id": "background", "value": "single-color" },
        { "setting_id": "bg_transparent", "value": false }
      ]
    },
    {
      "type": "range",
      "id": "gradient_angle_degree",
      "label": "Angle degree",
      "min": 0,
      "step": 1,
      "max": 360,
      "unit": "°",
      "default": 90,
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },
    {
      "type": "color",
      "id": "gradient_start",
      "label": "Gradient start",
      "default": "#DDDDDD",
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },
    {
      "type": "color",
      "id": "gradient_end",
      "label": "Gradient end",
      "default": "#FFFFFF",
      "visible_if": { "setting_id": "background", "value": "gradient" }
    },

    { "type": "header", "content": "Border" },
    { "type": "number", "id": "border_weight", "label": "Border weight", "default": 0 },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border style",
      "options": [
        { "label": "None", "value": "none" },
        { "label": "Solid", "value": "solid" },
        { "label": "Dashed", "value": "dashed" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#121212" },
    { "type": "number", "id": "border_radius_tl", "label": "Radius top-left", "default": 0 },
    { "type": "number", "id": "border_radius_tr", "label": "Radius top-right", "default": 0 },
    { "type": "number", "id": "border_radius_br", "label": "Radius bottom-right", "default": 0 },
    { "type": "number", "id": "border_radius_bl", "label": "Radius bottom-left", "default": 0 },

    { "type": "header", "content": "Effects" },
    { "type": "range", "id": "opacity", "label": "Opacity", "max": 1, "min": 0, "step": 0.1, "default": 1 },

    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "margin_top", "label": "Margin top", "default": 0 },
    { "type": "number", "id": "margin_right", "label": "Margin right", "default": 0 },
    { "type": "number", "id": "margin_bottom", "label": "Margin bottom", "default": 0 },
    { "type": "number", "id": "margin_left", "label": "Margin left", "default": 0 },
    { "type": "number", "id": "padding_top", "label": "Padding top", "default": 0 },
    { "type": "number", "id": "padding_right", "label": "Padding right", "default": 0 },
    { "type": "number", "id": "padding_bottom", "label": "Padding bottom", "default": 0 },
    { "type": "number", "id": "padding_left", "label": "Padding left", "default": 0 },

    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "lg_screens", "label": "Show on large screens", "default": true },
    { "type": "paragraph", "content": "1200px and wider" },
    { "type": "checkbox", "id": "md_screens", "label": "Show on medium screens", "default": true },
    { "type": "paragraph", "content": "992px - 1199px" },
    { "type": "checkbox", "id": "sm_screens", "label": "Show on small screens", "default": true },
    { "type": "paragraph", "content": "768px - 991px" },
    { "type": "checkbox", "id": "xs_screens", "label": "Show on extra small screens", "default": true },
    { "type": "paragraph", "content": "767px and smaller" },

    { "type": "header", "content": "Advanced" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "placeholder": "my-quantity" },
    { "type": "textarea", "id": "custom_css", "label": "Custom CSS", "placeholder": "transform: scale(2);\nbackdrop-filter: blur(2px);" }
  ]
}
{% endschema %}
