{% assign icons = '' %}

{% for i in (1..8) %}
  {% assign icon = 'icon_' | append: i %}

  {% if block.settings[icon] %}
    {% assign icons = icons | append: block.settings[icon] | append: ',' %}
  {% endif %}
{% endfor %}

{% assign icons_list = icons | split: ',' %}

{% if icons_list.size %}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,{% if block.settings.icon_sharp == 'solid' %}1{% else %}0{% endif %},0&icon_names={{ icons }}"
  />
{% endif %}

<div data-lego="trust-badges">
  <ul>
    {% for i in (1..8) %}
      {% assign icon = 'icon_' | append: i %}
      {% assign icon_color = 'icon_color_' | append: i %}
      {% assign is_custom_img = 'is_custom_img_' | append: i %}
      {% assign custom_img = 'custom_img_' | append: i %}
      {% assign title = 'title_' | append: i %}
      {% assign subtitle = 'subtitle_' | append: i %}
      {% assign link = 'link_' | append: i %}
      {% assign new_window = 'new_window_' | append: i %}

      {% if block.settings[title] != blank %}
        <li>
          {% if block.settings.clickable %}
            <a
              class="badge"
              href="{{ block.settings[link] }}"
              {% if block.settings[new_window] %}
                target="_blank"
              {% endif %}
            >
          {% else %}
            <div class="badge">
          {% endif %}
          {% if block.settings.icon_position == 'left' %}
            {% if block.settings[is_custom_img] %}
              {% assign fallback_image_url = 'default-fallback-image.webp' | asset_url %}
              <img
                src="{{ block.settings[custom_img].src | default: fallback_image_url }}"
                alt="{{ block.settings[title] }}"
                width="{{ block.settings.icon_size | append: 'px' }}"
                height="{{ block.settings.icon_size | append: 'px' }}"
                loading="lazy"
              >
            {% else %}
              <span class="material-symbols-outlined" style="color: {{ block.settings[icon_color].hex }};">
                {{ block.settings[icon] }}
              </span>
            {% endif %}
          {% endif %}
          {% unless block.settings.clickable %}
            <a
              class="content"
              href="{{ block.settings[link] }}"
              {% if block.settings[new_window] %}
                target="_blank"
              {% endif %}
            >
          {% else %}
            <div class="content">
          {% endunless %}
          <span class="title">{{ block.settings[title] }}</span>
          <p class="subtitle">{{ block.settings[subtitle] }}</p>
          {% unless block.settings.clickable %}
            </a>
          {% else %}
            </div>
          {% endunless %}
          {% if block.settings.icon_position == 'right' %}
            {% if block.settings[is_custom_img] %}
              {% assign fallback_image_url = 'default-fallback-image.webp' | asset_url %}
              <img
                src="{{ block.settings[custom_img].src | default: fallback_image_url }}"
                alt="{{ block.settings[title] }}"
                width="{{ block.settings.icon_size | append: 'px' }}"
                height="{{ block.settings.icon_size | append: 'px' }}"
                loading="lazy"
              >
            {% else %}
              <span class="material-symbols-outlined" style="color: {{ block.settings[icon_color].hex }};">
                {{ block.settings[icon] }}
              </span>
            {% endif %}
          {% endif %}
          {% if block.settings.clickable %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</div>

<style>
  #youcan-block--{{ block.id }} [data-lego="trust-badges"] {
    padding: {{ block.settings.padding | append: 'px' }};
    margin: {{ block.settings.margin | append: 'px' }};
    border-radius: {{ block.settings.border_radius | append: 'px' }};
    border: {{ block.settings.border_weight | append: 'px' }} {{ block.settings.border_style }} {{ block.settings.border_color.hex }};
    opacity: {{ block.settings.opacity }};

    ul {
      gap: {{ block.settings.gap | append: 'px' }};
      justify-content: {{ block.settings.align }};

      {% case block.settings.layout %}
        {% when 'grid' %}
          display: grid;
          grid-template-columns: repeat({{ block.settings.columns }}, 1fr);

          @media (width <= 769px) {
            grid-template-columns: 1fr;
          }

        {% when 'list' %}
          display: flex;
          flex-direction: column;

        {% when 'slide' %}
          display: flex;
          scrollbar-width: none;
          -ms-overflow-style: none;
          -webkit-overflow-scrolling: touch;
          scroll-behavior: smooth;
          overflow: scroll hidden;
          scroll-snap-type: x mandatory;
          justify-content: flex-start;

          li {
            scroll-snap-align: start;
            scroll-snap-stop: always;
            width: calc((100% - ({{ block.settings.gap | append: 'px' }} * ({{ block.settings.columns }} - 1))) / {{ block.settings.columns }});
            min-width: calc((100% - ({{ block.settings.gap | append: 'px' }} * ({{ block.settings.columns }} - 1))) / {{ block.settings.columns }});
          }

          @media (width <= 769px) {
            li {
              width: calc(100% - {{ block.settings.gap | append: 'px' }});
              min-width: calc(100% - {{ block.settings.gap | append: 'px' }});
            }
          }

      {% endcase %}

      li {
        .badge {
          display: flex;
          gap: 12px;
          justify-content: {{ block.settings.align }};

          .content {
            display: flex;
            flex-direction: column;
            gap: 4px;

            .title {
              color: {{ block.settings.title_color.hex }};
              text-transform: {{ block.settings.title_transform }};
              font-size: {{ block.settings.title_size | append: 'px' }};
              font-weight: {{ block.settings.title_weight }};
            }

            .subtitle {
              color: {{ block.settings.subtitle_color.hex }};
              text-transform: {{ block.settings.subtitle_transform }};
              font-size: {{ block.settings.subtitle_size | append: 'px' }};
              font-weight: {{ block.settings.subtitle_weight }};
            }
          }

          .material-symbols-outlined {
            font-size: {{ block.settings.icon_size | append: 'px' }};
            margin-inline: -4px;
            font-variation-settings:
              "FILL" {% if block.settings.icon_sharp == 'solid' %}1{% else %}0{% endif %},
              "wght" 400,
              "GRAD" 0,
              "opsz" 20;
          }

          img {
            object-fit: cover;
          }
        }
      }
    }

    {% if block.settings.width == 'custom' %}
      max-width: 100%;
      width: {{ block.settings.custom_width | append: 'px' }};
    {% endif %}

    {% case block.settings.background %}
      {% when 'single-color' %}
        {% unless block.settings.bg_transparent %}
          background-color: {{ block.settings.bg_color.hex }};
        {% endunless %}
      {% when 'gradient' %}
        background-image: linear-gradient({{ block.settings.gradient_angle_degree }}deg, {{ block.settings.gradient_start.hex }}, {{ block.settings.gradient_end.hex }});
      {% when 'image' %}
        background-image: url({{ block.settings.bg_img.src }});
        background-position: center;
        background-repeat: no-repeat;
        background-size: cover;
    {% endcase %}

    {% unless block.settings.lg_screens %}
      @media (width >= 1200px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.md_screens %}
      @media (992px <= width < 1200px)  {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.sm_screens %}
      @media (768px <= width < 992px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.xs_screens %}
      @media (width < 768px) {
        display: none;
      }
    {% endunless %}
  }

  {% if block.settings.custom_css != 'blank' %}
    #youcan-block--{{ block.id }} [data-lego="trust-badges"] {
      {{ block.settings.custom_css }}
    }
  {% endif %}
</style>

{% schema %}
{
  "label": "Trust badges",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "label": "Grid", "value": "grid" },
        { "label": "List", "value": "list" },
        { "label": "Slide", "value": "slide" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "max": 6,
      "min": 2,
      "step": 1,
      "id": "columns",
      "label": "Columns",
      "default": 4,
      "visible_if": { "setting_id": "layout", "operator": "!=", "value": "list" }
    },
    { "type": "range", "max": 80, "min": 0, "step": 2, "unit": "px", "id": "gap", "label": "Gap", "default": 24 },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "icon_sharp",
      "label": "Icon sharp",
      "options": [
        { "label": "Stroke", "value": "stroke" },
        { "label": "Solid", "value": "solid" }
      ],
      "default": "stroke"
    },
    {
      "type": "range",
      "max": 80,
      "min": 16,
      "step": 2,
      "unit": "px",
      "id": "icon_size",
      "label": "Icon size",
      "default": 40
    },
    { "type": "checkbox", "id": "clickable", "label": "Entire element clickable", "default": false },
    { "type": "header", "content": "Layout" },
    {
