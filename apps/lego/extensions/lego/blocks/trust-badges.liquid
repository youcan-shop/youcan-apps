      "max": 1,
      "step": 0.1,
      "default": 0.8,
      "visible_if": { "setting_id": "hover_enabled", "value": true }
    },
    {
      "type": "range",
      "id": "hover_scale",
      "label": "Hover scale",
      "min": 0.9,
      "max": 1.15,
