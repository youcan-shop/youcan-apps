{% if block.settings.icon %}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,{% if block.settings.icon_sharp == 'solid' %}1{% else %}0{% endif %},0&icon_names={{ block.settings.icon }}"
  />
{% endif %}

<a
  data-lego="button"
  href="{{ block.settings.url | default: '#' }}"
  {% unless block.settings.same_window %}
    target="_blank"
  {% endunless %}
>
  {% if block.settings.icon and block.settings.icon_position == 'left' %}
    <span class="material-symbols-outlined">
      {{ block.settings.icon }}
    </span>
  {% endif %}
  {{ block.settings.text }}
  {% if block.settings.icon and block.settings.icon_position == 'right' %}
    <span class="material-symbols-outlined">
      {{ block.settings.icon }}
    </span>
  {% endif %}
</a>

<style>
  #youcan-block--{{ block.id }} [data-lego="button"] {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.align }};
    text-transform: {{ block.settings.transform }};
    margin: {{ block.settings.margin | append: 'px' }};
    border-radius: {{ block.settings.border_radius | append: 'px' }};
    opacity: {{ block.settings.opacity }};
    width: {{ block.settings.width }};
    border: 1px solid transparent;
    color: {{ block.settings.primary_color.hex }};
    transition: 350ms cubic-bezier(0.27, 1.06, 0.18, 1);
    outline: 1px solid transparent;
    font: 400 14px/20px var(--font-family);

    {% case block.settings.style %}
      {% when 'filled' %}
        color: {{ block.settings.secondary_color.hex }};
        background-color: {{ block.settings.primary_color.hex }};
      {% when 'stroke' %}
        background-color: transparent;
        border-color: currentColor;
      {% when 'lighter' %}
        background-color: color-mix(in srgb, currentColor 15%, transparent);
      {% when 'ghost' %}
        background-color: transparent;
    {% endcase %}

    {% case block.settings.size %}
      {% when 'xl' %}
        gap: 14px;
        height: 44px;
        padding-inline: 16px;
        font: 500 16px/24px var(--font-family);
      {% when 'lg' %}
        gap: 12px;
        height: 40px;
        padding-inline: 14px;
      {% when 'md' %}
        gap: 12px;
        height: 36px;
        padding-inline: 12px;
      {% when 'sm' %}
        gap: 10px;
        height: 32px;
        padding-inline: 10px;
      {% when 'xs' %}
        gap: 10px;
        height: 28px;
        padding-inline: 8px;
    {% endcase %}

    .material-symbols-outlined {
      font-size: 20px;
      margin-inline: -4px;
      font-variation-settings:
        "FILL" {% if block.settings.icon_sharp == 'solid' %}1{% else %}0{% endif %},
        "wght" 400,
        "GRAD" 0,
        "opsz" 20;
    }

    {% unless block.settings.width == '100%' %}
      &:active {
        scale: 0.97;
      }
    {% endunless %}

    &:disabled {
      opacity: 0.5;
      pointer-events: none;
    }

    &:focus-visible {
      box-shadow: 0 0 transparent,
        0 0 transparent,
        0 0 0 2px white,
        0 0 0 4px {{ block.settings.primary_color.hex }};;
    }

    {% unless block.settings.lg_screens %}
      @media (width >= 1200px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.md_screens %}
      @media (992px <= width < 1200px)  {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.sm_screens %}
      @media (768px <= width < 992px) {
        display: none;
      }
    {% endunless %}
    {% unless block.settings.xs_screens %}
      @media (width < 768px) {
        display: none;
      }
    {% endunless %}
  }

  {% if block.settings.custom_css != 'blank' %}
    #youcan-block--{{ block.id }} [data-lego="button"] {
      {{ block.settings.custom_css }}
    }
  {% endif %}
</style>

{% schema %}
{
  "label": "Button",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "text", "label": "Label", "default": "Button" },
    { "type": "text", "id": "url", "label": "URL", "placeholder": "https://youcan.shop" },
    { "type": "checkbox", "id": "same_window", "label": "Open in same tab", "default": true },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "label": "Filled", "value": "filled" },
        { "label": "Stroke", "value": "stroke" },
        { "label": "Lighter", "value": "lighter" },
        { "label": "Ghost", "value": "ghost" }
      ],
      "default": "filled"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "label": "Xl", "value": "xl" },
        { "label": "Lg", "value": "lg" },
        { "label": "Md", "value": "md" },
        { "label": "Sm", "value": "sm" },
        { "label": "Xs", "value": "xs" }
      ],
      "default": "md"
    },
    { "type": "text", "id": "icon", "label": "Icon", "placeholder": "favorite" },
    { "type": "paragraph", "content": "Feel free to use [Google Icons](https://fonts.google.com/icons)" },
    {
      "type": "select",
      "id": "icon_position",
      "label": "Icon position",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Right", "value": "right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "icon_sharp",
      "label": "Icon sharp",
      "options": [
        { "label": "Stroke", "value": "stroke" },
        { "label": "Solid", "value": "solid" }
      ],
      "default": "stroke"
    },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        { "label": "Auto", "value": "fit-content" },
        { "label": "Full", "value": "100%" }
      ],
      "default": "fit-content"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "label": "Left", "value": "left" },
        { "label": "Center", "value": "center" },
        { "label": "Right", "value": "right" }
      ],
      "default": "center",
      "visible_if": { "setting_id": "width", "value": "100%" }
    },
    { "type": "header", "content": "Spacing" },
    { "type": "number", "id": "margin", "label": "Margin", "default": 0 },
    { "type": "header", "content": "Design" },
    {
      "type": "select",
      "id": "transform",
      "label": "Text transform",
      "options": [
        { "label": "Normal", "value": "none" },
        { "label": "Capitalize", "value": "capitalize" },
        { "label": "Uppercase", "value": "uppercase" },
        { "label": "Lowercase", "value": "lowercase" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "primary_color", "label": "Primary Color", "default": "#121212" },
    { "type": "color", "id": "secondary_color", "label": "Secondary color", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "border_style",
      "label": "Border style",
      "options": [
        { "label": "Solid", "value": "solid" },
        { "label": "Dashed", "value": "dashed" }
      ],
      "default": "solid",
      "visible_if": { "setting_id": "style", "value": "stroke" }
    },
    { "type": "number", "id": "border_radius", "label": "Border radius", "default": 8 },
    { "type": "header", "content": "Visibility" },
    { "type": "checkbox", "id": "lg_screens", "label": "Show on large screens", "default": true },
    { "type": "paragraph", "content": "1200px and wider" },
    { "type": "checkbox", "id": "md_screens", "label": "Show on medium screens", "default": true },
    { "type": "paragraph", "content": "992px - 1199px" },
    { "type": "checkbox", "id": "sm_screens", "label": "Show on small screens", "default": true },
    { "type": "paragraph", "content": "768px - 991px" },
    { "type": "checkbox", "id": "xs_screens", "label": "Show on extra small screens", "default": true },
    { "type": "paragraph", "content": "769px and smaller" },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacity",
      "max": 1,
      "min": 0,
      "step": 0.1,
      "default": 1
    },
    { "type": "header", "content": "Advanced" },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "placeholder": "my-button"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "placeholder": "transform: scale(2);\nbackdrop-filter: filter(2px);"
    }
  ]
}
{% endschema %}
