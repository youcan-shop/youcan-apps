{% render 'style.app' %}

<deja-vu
  hidden
  {% if block.settings.hide_current_product %}
    hide-current-product
  {% endif %}
  data-dv-style="{{ block.settings.product_card_style }}"
>
  {%
    render 'snippet.heading',
    title: block.settings.title,
    subheading: block.settings.subheading
  %}
  {% render 'snippet.product-card' %}

  <dv-carousel>
    <div dv-carousel="list" dv-product="list"></div>

    {% if block.settings.show_pagination %}
      <div class="dv-controls">
        <button type="button" class="dv-control" dv-carousel="arrow-previous" aria-label="{{ 'recently_viewed.carousel.previous' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 6L9 12L15 18"></path>
          </svg>
        </button>
        <button type="button" class="dv-control" dv-carousel="arrow-next" aria-label="{{ 'recently_viewed.carousel.next' | t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 6L15 12L9 18"></path>
          </svg>
        </button>
      </div>
    {% endif %}
  </dv-carousel>
</deja-vu>

{% render 'js.app' %}
{% render 'js.carousel' %}

