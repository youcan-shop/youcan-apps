{% comment %}
  Renders chat panel CSS styles

  Usage:
  {% render 'asset.chat-panel' %}
{% endcomment %}

{% style %}
  @keyframes ask-me-rise {
    from {
      translate: 0 var(--spacing-10);
      opacity: 0;
    }

    to {
      translate: 0 0;
      opacity: 1;
    }
  }

  @keyframes ask-me-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--color-primary) 35%, transparent);
    }

    50% {
      box-shadow: 0 0 0 10px color-mix(in oklab, var(--color-primary) 0%, transparent);
    }
  }

  :has(> ui-ask-me[data-design-mode]) {
    position: fixed;
    z-index: 48;
    inset-block-end: var(--spacing-64);
    width: fit-content;

    &:has(> ui-ask-me[data-position='end']) {
      inset-inline-end: var(--spacing-24);
    }

    &:has(> ui-ask-me[data-position='start']) {
      inset-inline-start: var(--spacing-24);
    }
  }

  ui-ask-me {
    --launcher-inset: var(--spacing-64);

    display: block;
    position: fixed;
    z-index: 48;
    inset-block-end: var(--launcher-inset);
    background-color: transparent;

    &[data-design-mode] {
      pointer-events: auto !important;
      position: static;
    }

    &[data-position='end'] {
      inset-inline-end: var(--spacing-24);
    }

    &[data-position='start'] {
      inset-inline-start: var(--spacing-24);
    }

    [ui-ask-me='launcher'] {
      max-width: min(80vw, 280px);
      animation: ask-me-pulse 2400ms cubic-bezier(0.34, 0.8, 0.34, 1) infinite;

      @media (prefers-reduced-motion: reduce) {
        animation: none;
      }
    }

    &:has([ui-ask-me='panel']:popover-open) [ui-ask-me='launcher'] {
      animation: none;
    }

    [ui-ask-me='panel'] {
      --panel-width: 360px;

      position: fixed;
      flex-direction: column;
      inset: auto;
      inset-block-end: calc(var(--launcher-inset) + var(--spacing-64) + var(--spacing-4));
      width: var(--panel-width);
      max-width: calc(100vw - var(--spacing-32));
      max-height: min(70vh, 560px);
      margin: var(--spacing-0);
      padding: var(--spacing-0);
      overflow: hidden;
      transition:
        opacity var(--transition-standard-default-effects),
        translate var(--transition-expressive-fast-spatial),
        scale var(--transition-expressive-fast-spatial),
        display var(--transition-standard-default-effects) allow-discrete,
        overlay var(--transition-standard-default-effects) allow-discrete;
      border: 1px solid var(--color-outline-variant);
      border-radius: var(--radius-20);
      background-color: var(--color-surface);
      box-shadow:
        0 1px 1px color-mix(in srgb, var(--color-on-surface) 5%, transparent),
        0 8px 20px -8px color-mix(in srgb, var(--color-on-surface) 18%, transparent),
        0 24px 48px -20px color-mix(in srgb, var(--color-on-surface) 26%, transparent);
      color: var(--color-on-surface);
      opacity: 0;
      translate: 0 var(--spacing-12);
      scale: 0.98;

      &:popover-open {
        display: flex;
        opacity: 1;
        translate: 0 0;
        scale: 1;

        @starting-style {
          opacity: 0;
          translate: 0 var(--spacing-12);
          scale: 0.98;
        }
      }
    }

    &[data-position='end'] [ui-ask-me='panel'] {
      inset-inline-end: var(--spacing-24);
    }

    &[data-position='start'] [ui-ask-me='panel'] {
      inset-inline-start: var(--spacing-24);
    }

    .header {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--spacing-12);
      padding: var(--spacing-14) var(--spacing-16);
      background-color: var(--color-primary);
      color: var(--color-on-primary);
    }

    .title {
      flex: 1;
      min-width: 0;
      margin: var(--spacing-0);
      overflow: hidden;
      font: var(--font-title-md);
      letter-spacing: -0.01em;
      color: inherit;
      text-align: start;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .avatar {
      --avatar-size: 40px;

      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      width: var(--avatar-size);
      height: var(--avatar-size);
      border-radius: var(--radius-rounded);
      background-color: color-mix(in srgb, currentcolor 16%, transparent);
      color: inherit;
    }

    .list {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-20);
      min-height: 0;
      margin: var(--spacing-0);
      padding: var(--spacing-16);
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: transparent;
      scrollbar-width: thin;
      scrollbar-color: color-mix(in srgb, var(--color-on-surface) 18%, transparent) transparent;

      &[hidden] {
        display: none;
      }
    }

    &:has([ui-ask-me='panel']:popover-open) [ui-ask-me='question'] {
      animation: ask-me-rise var(--transition-expressive-fast-spatial) both;

      &:nth-child(2) {
        animation-delay: 50ms;
      }

      &:nth-child(3) {
        animation-delay: 100ms;
      }

      &:nth-child(4) {
        animation-delay: 150ms;
      }

      &:nth-child(5) {
        animation-delay: 200ms;
      }

      &:nth-child(n + 6) {
        animation-delay: 250ms;
      }
    }

    .empty {
      margin: var(--spacing-0);
      padding: var(--spacing-32) var(--spacing-24);
      background-color: transparent;
      font: var(--font-body-md);
      color: var(--color-on-surface-variant);
      text-align: center;
      text-wrap: balance;
    }
  }

  @media (width <= 769px) {
    ui-ask-me {
      [ui-ask-me='panel'] {
        --panel-width: auto;

        max-width: none;
      }

      &[data-position='end'] [ui-ask-me='panel'],
      &[data-position='start'] [ui-ask-me='panel'] {
        inset-inline: var(--spacing-16);
      }
    }
  }
{% endstyle %}
