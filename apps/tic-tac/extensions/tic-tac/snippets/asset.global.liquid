{% comment %}
  Renders global CSS styles (tokens | colors | resets)

  Usage:
  {% render 'asset.global' %}
{% endcomment %}

{% unless block.settings.font == 'inherit' %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css?family={{ block.settings.font }}"
  >

  {% style %}
    #youcan-block--{{ block.id }} {
      --font-app-family: '{{ block.settings.font | replace: '+', ' ' }}';
    }
  {% endstyle %}
{% else %}
  {% style %}
    #youcan-block--{{ block.id }} {
      --font-app-family: var(--font-family);
    }
  {% endstyle %}
{% endunless %}

{% style %}
  /* Tokens */
  #youcan-block--{{ block.id }} {
    --spacing-0: 0px;
    --spacing-2: 2px;
    --spacing-4: 4px;
    --spacing-6: 6px;
    --spacing-8: 8px;
    --spacing-10: 10px;
    --spacing-12: 12px;
    --spacing-14: 14px;
    --spacing-16: 16px;
    --spacing-24: 24px;
    --spacing-32: 32px;
    --spacing-48: 48px;
    --spacing-64: 64px;
    --radius-0: 0px;
    --radius-4: 4px;
    --radius-8: 8px;
    --radius-12: 12px;
    --radius-16: 16px;
    --radius-20: 20px;
    --radius-28: 28px;
    --radius-32: 32px;
    --radius-48: 48px;
    --radius-rounded: calc(1px * infinity);
    --font-56: 400 56px/64px var(--font-app-family);
    --font-44: 400 44px/52px var(--font-app-family);
    --font-36: 400 36px/44px var(--font-app-family);
    --font-28: 400 28px/36px var(--font-app-family);
    --font-22: 400 22px/28px var(--font-app-family);
    --font-16: 500 16px/24px var(--font-app-family);
    --font-14: 400 14px/20px var(--font-app-family);
    --font-12: 400 12px/16px var(--font-app-family);
  }

  /* Globals */
  #youcan-block--{{ block.id }} {
    * {
      font-family: var(--font-app-family);
    }

    h1,
    h2,
    h3,
    h4 {
      text-wrap: balance;
      overflow-wrap: break-word;
    }

    ul {
      list-style: none;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    p {
      text-wrap: pretty;
    }

    select {
      padding-block: var(--spacing-0);
    }
  }
{% endstyle %}
