{% comment %}
  Renders close button

  Usage:
  {% render 'component.close' %}
{% endcomment %}

<button data-component="close" aria-label="Close">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" height="20" width="20">
    <path d="M8.70705 8 12 4.70705 11.29295 4 8 7.29295 4.70715 4 4 4.70705 7.29295 8 4 11.29295 4.70715 12 8 8.70705 11.29295 12 12 11.29295 8.70705 8z" fill="currentColor" stroke-width="0.5"></path>
    <path d="M0 0h16v16H0Z" fill="none" stroke-width="0.5"></path>
  </svg>
</button>

<style>
  #youcan-block--{{ block.id }} [data-component='close'] {
    border: none;
    position: absolute;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.title_color.hex }} !important;
    background-color: transparent !important;
    padding: 0 !important;
    inset-block-start: var(--spacing-10);
    inset-inline-end: var(--spacing-10);

    {% if block.settings.layout == 'balanced' %}
      @media (width > 769px) {
        inset-block-start: 50%;
        transform: translateY(-50%);
      }
    {% endif %}
  }
</style>
