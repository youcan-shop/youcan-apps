{% render 'asset.global' %}
{% render 'asset.app' %}

{% if block.settings.cta == 'clickable' %}
  <a data-app="tic-tac" href="{{ block.settings.link | default: '#' }}">
{% else %}
  <div data-app="tic-tac">
{% endif %}
<div
  class="wrapper"
  {% if block.settings.style == 'sticky' %}
    data-positioning="{{ block.settings.positioning }}"
    {% if block.settings.positioning == 'top-page' %}
      data-sticky-top-top-while-scrolling="{{ block.settings.sticky_to_top_while_scrolling }}"
    {% endif %}
  {% endif %}
  data-style="{{ block.settings.style }}"
  data-layout="{{ block.settings.layout }}"
  data-background="{{ block.settings.background }}"
  {% if block.settings.background == 'single-color' and block.settings.bg_transparent %}
    data-background-transparent="true"
  {% endif %}
>
  {% if block.settings.title or block.settings.subheading %}
    <div class="content">
      {% if block.settings.title %}
        {% render 'component.title' %}
      {% endif %}
      {% if block.settings.subheading %}
        {% render 'component.subheading' %}
      {% endif %}
    </div>
  {% endif %}
  {% render 'component.timer' %}
  {% if block.settings.cta == 'button' and block.settings.button_text %}
    {% render 'component.cta' %}
  {% endif %}
  {% if block.settings.close_icon %}
    {% render 'component.close' %}
  {% endif %}
</div>
{% if block.settings.cta == 'clickable' %}
  </a>
{% else %}
  </div>
{% endif %}

